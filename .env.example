# 提供方凭证。示例文件里只放占位符，永远不要写入真实密钥。
JEV_API_KEY=replace-with-your-rotated-key
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=30
JEV_MODEL=replace-with-the-model-id-your-account-can-use

# 可选。两项必须同时配置，或同时留空。留空时 agent 在路由要求 LLM 委托时
# fail closed，工具参数解析成空、由工具自己拒绝，评测基线也跑不起来。
# LLM_MAX_TOKENS 限制合成内容的长度，写很大的文件需要比默认值更高的预算。
# LLM_API_STYLE 选择 wire format："messages" 走 Anthropic Messages API（默认），
# "chat_completions" 走 OpenAI 兼容网关，后者的 base URL 必须自带版本段
# （例如 https://api.stepfun.com/step_plan/v1）。
LLM_API_KEY=replace-with-your-rotated-llm-key
LLM_BASE_URL=https://api.anthropic.com
LLM_API_STYLE=messages
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024

# 策略阈值。都是项目初值，不是服务商推荐值；改它应当由评测数据驱动，
# 用 `python -m evals --mode calibrate` 得到一组候选，再决定要不要写在这里。
# 注意：工具的 write / external 风险等级无条件触发确认，与这几个数值无关。
JEV_CONFIRMATION_THRESHOLD=0.75
JEV_RISK_THRESHOLD=2.5
JEV_REASONING_THRESHOLD=0.70
JEV_ROUTE_CONFIDENCE_THRESHOLD=0.75
JEV_COMPLETION_THRESHOLD=0.75

# 待确认的有效期（秒）。超时按「没有批准」处理。
JEV_CONFIRMATION_TTL_SECONDS=900

# 可选。设置后所有端点要求 `Authorization: Bearer <token>`；不设置时不做鉴权，
# 服务启动会打一条警告。对外提供服务前必须设置。
# JEV_API_TOKEN=replace-with-a-long-random-token
