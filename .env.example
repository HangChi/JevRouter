JEV_API_KEY=replace-with-your-rotated-key
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=30
JEV_MODEL=replace-with-the-model-id-your-account-can-use

# Optional. Both must be set together, or neither. Without them the agent fails
# closed when the router asks for LLM delegation, tool arguments resolve to
# nothing so the tool refuses them, and the eval baseline cannot run.
# LLM_MAX_TOKENS bounds synthesized content, so a very large write_file needs a
# higher value than the default.
# LLM_API_STYLE picks the wire format: "messages" for the Anthropic Messages
# API (default) or "chat_completions" for an OpenAI-compatible gateway, whose
# base URL must already carry the version segment (e.g.
# https://api.stepfun.com/step_plan/v1).
LLM_API_KEY=replace-with-your-rotated-llm-key
LLM_BASE_URL=https://api.anthropic.com
LLM_API_STYLE=messages
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
